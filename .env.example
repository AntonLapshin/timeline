# Timeline — environment variables (template)
#
# Copy this file to `.env` and fill in your local values. NEVER commit `.env` —
# it holds secrets and is gitignored. Only placeholders live in this example.

# --- Web / API ---
# Loopback bind only (no auth). Do NOT set 0.0.0.0.
TIMELINE_HOST=127.0.0.1
TIMELINE_PORT=8123
# Data directory (SQLite lives here; gitignored).
TIMELINE_DATA_DIR=./data
TIMELINE_DB_NAME=timeline.db
# Enable SQLite WAL journal mode (1 = on).
TIMELINE_WAL=1
# Seed the initial example events on first run (1 = on).
TIMELINE_SEED=1

# --- Localization / quiet hours (defaults: UTC, en-US, no quiet hours) ---
# IANA timezone for event parsing/display ("now + tz").
TZ=UTC
# Locale used for date formatting.
LOCALE=en-US
# Quiet hours for reminders (HH:MM, 24h). Leave empty for no quiet hours.
QUIET_START=
QUIET_END=

# --- Telegram (outbound + inbound; fill in locally) ---
# Bot token from @BotFather. Placeholder only — never commit a real token.
BOT_TOKEN=changeme
# Numeric Telegram user id for the single-user allowlist.
TELEGRAM_USER_ID=changeme

# --- LLM extraction (JoinGonka / OpenAI-compatible) ---
LLM_BASE_URL=https://gate.joingonka.ai/openai/v1
LLM_API_KEY=changeme
LLM_MODEL=changeme

# --- Email (optional, feature-flag) ---
SMTP_HOST=changeme
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASS=changeme
SMTP_FROM=changeme
SMTP_TO=changeme
