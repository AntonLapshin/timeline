{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AntonLapshin/timeline/schemas/event.schema.v1.json",
  "title": "Event",
  "description": "A timeline event (one-time or recurrent). Schema version 1 per manifest §5. Shared between the web app (TypeScript) and the API (Python) so both sides agree on the wire format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "type",
    "start_at",
    "tz",
    "priority",
    "channels",
    "reminder_offsets",
    "source",
    "status"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Stable database identifier, present once persisted."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Human-friendly title of the event."
    },
    "description": {
      "type": "string",
      "default": "",
      "description": "Optional free-form description."
    },
    "location_url": {
      "type": "string",
      "default": "",
      "description": "Optional location or URL."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Free-form tags for search/filter."
    },
    "type": {
      "type": "string",
      "enum": ["one_time", "recurrent"],
      "description": "Whether the event recurs."
    },
    "start_at": {
      "type": "string",
      "format": "date-time",
      "description": "Start time as an ISO-8601 UTC timestamp."
    },
    "end_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null,
      "description": "Optional end time as an ISO-8601 UTC timestamp."
    },
    "all_day": {
      "type": "boolean",
      "default": false,
      "description": "Whether the event spans the whole day."
    },
    "tz": {
      "type": "string",
      "description": "IANA timezone name used for display, e.g. Europe/Berlin."
    },
    "rrule": {
      "type": ["string", "null"],
      "default": null,
      "description": "RFC 5545 recurrence rule for recurrent events."
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "medium", "low"],
      "description": "Reminder priority level."
    },
    "channels": {
      "type": "array",
      "items": { "type": "string", "enum": ["telegram", "email"] },
      "default": ["telegram"],
      "description": "Reminder delivery channels."
    },
    "reminder_offsets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]+[dhm]$" },
      "default": [],
      "description": "Reminder offsets before the event, e.g. 7d, 1d, 2h."
    },
    "remind_time_of_day": {
      "type": ["string", "null"],
      "default": null,
      "description": "Time of day for day-level reminders, e.g. 09:00."
    },
    "repeat_until_ack": {
      "type": "boolean",
      "default": false,
      "description": "Whether critical reminders repeat until acknowledged."
    },
    "snooze_allowed": {
      "type": "boolean",
      "default": true,
      "description": "Whether the recipient may snooze the reminder."
    },
    "email_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether email delivery is enabled for this event."
    },
    "email_to": {
      "type": ["string", "null"],
      "default": null,
      "description": "Optional email recipient override."
    },
    "source": {
      "type": "string",
      "enum": ["web", "telegram_text", "telegram_voice", "ai"],
      "description": "How the event was captured."
    },
    "raw_input": {
      "type": ["string", "null"],
      "default": null,
      "description": "Original natural-language input, if any."
    },
    "ai_confidence": {
      "type": ["number", "null"],
      "default": null,
      "description": "Confidence score from AI extraction, if any."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "archived"],
      "description": "Lifecycle status of the event."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC creation timestamp."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC last-update timestamp."
    }
  }
}
